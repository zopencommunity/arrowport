# bump: arrow-version /ARROW_VERSION="(.*)"/ https://github.com/apache/arrow.git|semver:*
ARROW_VERSION="25.0.1"

###
### Apache Arrow C++, built as a SHARED library for pyarrow to link against.
### pyarrow cannot build this itself -- its CMakeLists does find_package(Arrow
### REQUIRED) -- so the C++ library has to exist first, which is why these are
### two ports rather than one. Arrow C++ is also interpreter-independent, while
### pyarrow builds a wheel per ABI; bundling would rebuild a very large C++
### project three times for nothing.
###
### It must be SHARED, and that is not a preference. pyarrow links Arrow into
### libarrow_python and, when Arrow is static, upstream links it PRIVATE
### (python/CMakeLists.txt ~526) on the assumption that ELF re-exports those
### symbols to the Cython extension modules. z/OS DLLs export only what is
### explicitly exported, through a side deck, so with a static Arrow every Arrow
### symbol comes back UNRESOLVED when the extensions link -- starting with
### arrow::compute::Initialize. Verified: shared Arrow builds and pyarrow then
### imports and runs.
###
### libarrow.so comes out at ~50 MB and libarrow_compute.so at ~34 MB, and a
### program linked against them produces correct results on this byte order --
### int64 arithmetic and string offsets both verified, the latter being where
### endianness actually bites.
###
### Six patches were needed, all of them platform differences rather than Arrow
### bugs; patches/arrow-25.0.1-zos.patch carries them and the README explains
### each one.
###
### The settings that are load-bearing, in the order they were discovered:covered:
###
###   ARROW_CPU_FLAG=s390x
###     CMake reports CMAKE_SYSTEM_PROCESSOR as the machine type ("8561"),
###     which Arrow does not recognise: "Unknown system processor". Arrow does
###     have an s390x path -- IBM contributed it -- and the detection is
###     guarded by if(NOT DEFINED ARROW_CPU_FLAG), so naming it directly skips
###     the detection rather than patching it.
###
###   CMAKE_CXX_STANDARD=20
###     Arrow 25 requires it: "Cannot set a CMAKE_CXX_STANDARD smaller than 20".
###     Verified working on this compiler -- concepts, std::span, __cplusplus
###     202002.
###
###   CMAKE_RANLIB=/bin/true
###     There is no ranlib here; ar maintains the index itself, as on AIX.
###     CMAKE_RANLIB ends up as ":" and Arrow does find_program() on it:
###     "Could not find EP_CMAKE_RANLIB using the following names: :".
###
###   -faligned-allocation
###     Without it every file that news an over-aligned type fails with
###     "aligned allocation function of type ... is only available on",
###     starting with memory_pool.cc.
###
###   -include <xsimd-zos-defaults.h>, from the xsimd port
###     Arrow requires xsimd and uses batches in its kernels. On this platform
###     xsimd only works through its emulated backend, and the settings that
###     select it cannot be passed as -D flags -- the value contains angle
###     brackets, so a build system passing it through a shell turns "<128>"
###     into a redirection and the compiler probe fails with
###     'bad file descriptor "128"'. xsimdport delivers them as a force-include
###     header and exports it, so listing xsimd as a dependency is enough.
###
###   xsimd_SOURCE=SYSTEM
###     Otherwise Arrow tries to download its own copy, which fails here.
###     Using the port is better anyway: it is the one that works.
###

export ZOPEN_PROJECT_NAME="arrow"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_CATEGORIES="development library"

export ZOPEN_STABLE_URL="https://github.com/apache/arrow.git"
export ZOPEN_STABLE_TAG="apache-arrow-${ARROW_VERSION}"
export ZOPEN_STABLE_DEPS="zoslib make cmake xsimd snappy utf8proc zstd lz4 bzip2 zlib rapidjson"

export ZOPEN_DEV_URL="https://github.com/apache/arrow.git"
export ZOPEN_DEV_DEPS="${ZOPEN_STABLE_DEPS}"

export ZOPEN_RUNTIME_DEPS=""
export ZOPEN_COMP="CLANG"

# -faligned-allocation goes here, not in -DCMAKE_CXX_FLAGS. CMake seeds
# CMAKE_CXX_FLAGS from the environment CXXFLAGS on the first configure, but
# passing -DCMAKE_CXX_FLAGS replaces it -- which would silently drop everything
# zopen composes there, including zoslib -isystem path, its ZOSLIB_OVERRIDE_CLIB
# defines and its symbolfixes force-include. Losing those does not fail at
# configure; it fails much later with zoslib own time.h reporting
# "unknown type name time_t", which reads as a broken compiler.
#
# The xsimd force-include arrives the same way, from xsimdport.
#
# -DDATE_BUILD_DLL makes Arrow's vendored date library export its symbols.
#
# tz.h defines DATE_API as __attribute__((visibility("default"))) only when
# DATE_BUILD_DLL is set, and as nothing otherwise. On ELF that costs nothing --
# default visibility is exported anyway. Here, a DLL exports only what is
# explicitly marked, so without it libarrow_compute.so cannot bind to
# libarrow.so and the link fails with
#
#   IEW2456E SYMBOL _ZNK14arrow_vendored4date9time_zone13get_info_impl...
#            UNRESOLVED. MEMBER COULD NOT BE INCLUDED FROM THE DESIGNATED
#            CALL LIBRARY.
#
# even though nm shows the symbol present and defined (T) inside libarrow.so.
export ZOPEN_EXTRA_CXXFLAGS="-faligned-allocation -DDATE_BUILD_DLL"

# Do not link zopen's zoslib environment hook into these libraries.
#
# zopen normally generates .zoslib_hooks/zoslib_env_hook.o and appends it to
# every link, so that zoslib can set environment variables before main runs.
# That is right for an executable and wrong for a DLL: when Python dlopen's an
# extension that depends on libarrow.so, the hook runs during load and abends
#
#   CEE3250C The system or user abend U4093 R=000000CC was issued.
#            From entry point zoslib_env_hook ...
#
# with no Python traceback. It is hard to attribute because the module that
# appears to fail does not define the symbol -- it is resolved out of
# libarrow.so -- so nm points at the wrong file.
#
# zopen-build supports suppressing it, which is preferable to editing the link
# line after the fact.
export ZOPEN_SKIP_ZOSLIB_ENV_HOOK=1

# Arrow's CMakeLists is in cpp/, not at the top of the repo.
#
# ARROW_DEPENDENCY_USE_SHARED=OFF makes Arrow pick the static target out of each
# dependency CMake config. Left on, it selects the shared ones -- and an imported
# SHARED target on this platform wants a side-deck as its import library, which
# these static-only ports do not ship:
#   IMPORTED_IMPLIB not set for imported target "zstd::libzstd_shared"
#
# The compression libraries are named explicitly rather than left to discovery.
# BZip2 needs BZIP2_LIBRARY_RELEASE specifically, not just BZIP2_LIBRARIES:
# CMake FindBZip2 builds the BZip2::BZip2 imported target from the former, and
# without it the configure fails late with
#   IMPORTED_LOCATION not set for imported target "BZip2::BZip2"
# rather than with anything saying the library was not found.
# Arrow's Find*Alt modules build library names that do not match what these
# ports install, so a plain prefix path finds the headers and then reports
# "Could NOT find lz4Alt (missing: LZ4_LIB)". The *_HOME variables come from
# each dependency own environment.
#
# Everything is SYSTEM because nothing can be downloaded here: CMake's
# FetchContent fails TLS verification (status_code 60) even though curl works,
# so a BUNDLED dependency is a build failure rather than a slow build.
export ZOPEN_CONFIGURE="cmake"
export ZOPEN_CONFIGURE_OPTS="-S cpp -B ../build --install-prefix \"\$ZOPEN_INSTALL_DIR/\" \
 -DCMAKE_BUILD_TYPE=Release \
 -DCMAKE_CXX_STANDARD=20 \
 -DCMAKE_AR=/bin/ar -DCMAKE_RANLIB=/bin/true \
 -DARROW_CPU_FLAG=s390x \
 -DARROW_DEPENDENCY_SOURCE=SYSTEM -Dxsimd_SOURCE=SYSTEM \
 -DARROW_DEPENDENCY_USE_SHARED=OFF \
 -DCMAKE_PREFIX_PATH=\"\$XSIMD_HOME\" \
 -DLZ4_LIB=\$LZ4_HOME/lib/liblz4.a -DLZ4_INCLUDE_DIR=\$LZ4_HOME/include \
 -DSnappy_LIB=\$SNAPPY_HOME/lib/libsnappy.a -DSnappy_INCLUDE_DIR=\$SNAPPY_HOME/include \
 -DZSTD_LIB=\$ZSTD_HOME/lib/libzstd.a -DZSTD_INCLUDE_DIR=\$ZSTD_HOME/include \
 -Dutf8proc_LIB=\$UTF8PROC_HOME/lib/libutf8proc.a -Dutf8proc_INCLUDE_DIR=\$UTF8PROC_HOME/include \
 -DBZIP2_LIBRARY_RELEASE=\$BZIP2_HOME/lib/libbz2.a \
 -DBZIP2_LIBRARIES=\$BZIP2_HOME/lib/libbz2.a -DBZIP2_INCLUDE_DIR=\$BZIP2_HOME/include \
 -DZLIB_LIBRARY=\$ZLIB_HOME/lib/libz.a -DZLIB_INCLUDE_DIR=\$ZLIB_HOME/include \
 -DRapidJSON_ROOT=\$RAPIDJSON_HOME \
 -DARROW_BUILD_SHARED=ON -DARROW_BUILD_STATIC=OFF \
 -DARROW_BUILD_TESTS=OFF -DARROW_BUILD_BENCHMARKS=OFF \
 -DARROW_BUILD_EXAMPLES=OFF -DARROW_BUILD_UTILITIES=OFF \
 -DARROW_COMPUTE=ON -DARROW_CSV=ON -DARROW_JSON=ON -DARROW_IPC=ON \
 -DARROW_FILESYSTEM=ON -DARROW_PARQUET=OFF -DARROW_DATASET=OFF \
 -DARROW_ACERO=OFF -DARROW_FLIGHT=OFF -DARROW_S3=OFF -DARROW_GCS=OFF \
 -DARROW_JEMALLOC=OFF -DARROW_MIMALLOC=OFF \
 -DARROW_WITH_SNAPPY=ON -DARROW_WITH_ZSTD=ON -DARROW_WITH_LZ4=ON \
 -DARROW_WITH_BZ2=ON -DARROW_WITH_ZLIB=ON -DARROW_WITH_UTF8PROC=ON \
 -DARROW_WITH_BROTLI=OFF -DARROW_WITH_RE2=OFF"

export ZOPEN_MAKE="cmake"
export ZOPEN_MAKE_OPTS="--build ../build --parallel \$ZOPEN_NUM_JOBS --config Release"
export ZOPEN_MAKE_MINIMAL=Y
export ZOPEN_INSTALL="cmake"
export ZOPEN_INSTALL_OPTS="--install ../build"
# Arrow's own test suite is deliberately not run yet, and that is the most
# important thing outstanding about this port. What is established so far is
# that the library builds and that a couple of array types round-trip
# correctly; that is not the same as every byte-order path being right on a
# big-endian machine, and only the suite will say.
#
# It is parked rather than abandoned because turning it on is not free:
#
#   ARROW_BUILD_TESTS=ON sets ARROW_TESTING, which makes Arrow require Boost.
#   That analysis was done when this port built static, and it no longer holds:
#   the branch wanting boost::filesystem is gated on ARROW_BUILD_SHARED, which
#   is now ON. When tests are revisited, the Boost component list has to be
#   re-checked rather than assumed empty -- the earlier "headers only" finding
#   was a consequence of the static build, not a property of Arrow.
#
#   GTest is the actual blocker. Arrow probes it with FindGTestAlt and the
#   probe fails:
#
#     Could NOT find GTestAlt (missing: GTestAlt_CXX_STANDARD_AVAILABLE)
#
#   which is Arrow compiling a small program against GTest at the required C++
#   standard, not a missing package. googletestport exists; whether its build
#   satisfies that probe is untested.
#
# Turning it back on means: add googletest and boost to the deps above, set
# ARROW_BUILD_TESTS=ON, put BOOST_HOME back on CMAKE_PREFIX_PATH, and switch
# ZOPEN_CHECK to ctest with
#   ZOPEN_CHECK_OPTS="--test-dir ../build --output-on-failure"
export ZOPEN_CHECK="skip"

# Drop the duplicate zoslib include path before configuring.
#
# zopen puts zoslib's headers on the search path twice: once through the merged
# /data/zopen/usr/local/include, which is a tree of symlinks, and again through
# zoslib's own -isystem. Both resolve to the same files, and the pair breaks
# #include_next.
#
# zoslib's time.h is the one that shows it. It is reached as
#
#   libc++ wchar.h -> /usr/include/wchar.h -> <time.h>
#
# which lands on the symlink in the merged directory. That file does
# "#include_next <time.h>" to chain to the real system header -- but the next
# time.h on the path is zoslib's own copy, whose include guard is already set,
# so it expands to nothing. /usr/include/time.h is never reached, time_t is
# never defined, and the failure surfaces as
#
#   zoslib/include/time.h:56: error: unknown type name 'time_t'
#
# followed by a cascade through libc++ (CHAR_BIT undeclared in <ratio>,
# unresolved using declarations in <hash.h>) that looks nothing like an include
# path problem.
#
# Removing the second copy fixes it, and costs nothing: the merged directory
# still exposes every zoslib header, <zos-tls.h> included -- verified.
zopen_pre_configure() {
  if [ -n "${ZOSLIB_HOME}" ]; then
    CFLAGS=$(echo " ${CFLAGS} " | sed -e "s| -isystem ${ZOSLIB_HOME}/include | |g")
    CXXFLAGS=$(echo " ${CXXFLAGS} " | sed -e "s| -isystem ${ZOSLIB_HOME}/include | |g")
    export CFLAGS CXXFLAGS
    printInfo "- dropped the duplicate zoslib include path (breaks #include_next)"
  fi
  return 0
}

# Install the DLLs, which CMake does not.
#
# A SHARED target on this platform produces two artifacts: the DLL (libarrow.so)
# and a side deck (libarrow.x) that consumers link against. CMake's z/OS support
# maps both the ARCHIVE and the LIBRARY/RUNTIME destinations to the side deck --
# the generated cmake_install.cmake carries
#
#   file(INSTALL ... TYPE STATIC_LIBRARY ... "libarrow.x")
#
# twice and nothing for the .so. The install therefore looks complete, and link
# time still works because the side decks are present; only loading fails, with
#
#   CEE3501S The module libarrow.so was not found.
#
# so the gap would otherwise surface in a dependent port rather than here.
zopen_post_install() {
  _ar_lib="${ZOPEN_INSTALL_DIR}/lib"
  _ar_built="${ZOPEN_ROOT}/build/release"

  printHeader "Installing the shared libraries CMake left behind"
  if [ ! -d "${_ar_built}" ]; then
    printSoftError "build output directory ${_ar_built} does not exist"
    return 1
  fi

  _ar_n=0
  for _ar_so in "${_ar_built}"/*.so; do
    [ -f "${_ar_so}" ] || continue
    cp "${_ar_so}" "${_ar_lib}/" || return 1
    printInfo "- installed $(basename "${_ar_so}")"
    _ar_n=$((_ar_n + 1))
  done

  if [ "${_ar_n}" -eq 0 ]; then
    printSoftError "FAIL: no .so files were produced in ${_ar_built}"
    return 1
  fi

  # Every side deck must have its DLL beside it. A side deck without one is the
  # failure described above: it links and then cannot load.
  for _ar_x in "${_ar_lib}"/*.x; do
    [ -f "${_ar_x}" ] || continue
    _ar_base=$(basename "${_ar_x}" .x)
    if [ ! -f "${_ar_lib}/${_ar_base}.so" ]; then
      printSoftError "FAIL: ${_ar_base}.x has no ${_ar_base}.so beside it"
      return 1
    fi
  done
  printInfo "PASS: ${_ar_n} shared libraries installed, each with its side deck"
  return 0
}

zopen_check_results() {
cat <<ZZ
actualFailures:0
totalTests:1
expectedFailures:0
expectedTotalTests:1
ZZ
}

# LIBPATH matters here in a way it does not on Linux.
#
# Arrow is now a set of DLLs, and z/OS resolves them at run time through LIBPATH
# only -- there is no $ORIGIN and no rpath (the linker rejects -rpath outright:
# "IEW5003 -r is not a valid option"). Anything that loads libarrow.so, including
# a pyarrow extension module imported by Python, needs this directory on LIBPATH
# or fails with
#
#   CEE3501S The module libarrow.so was not found.
zopen_append_to_env() {
cat <<ZZ
if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\$PWD/lib"
  # The side deck, not -larrow. On z/OS "-l<name>" resolves to lib<name>.a, and
  # this port no longer builds a static archive, so -larrow breaks every link in
  # a dependent port -- including CMake's own compiler test, which fails the
  # configure with "IEW5034 The archive library libarrow.a cannot be found."
  # long before the project's own sources are reached.
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} \$PWD/lib/libarrow.x"
  export ARROW_HOME="\$PWD"
fi
export LIBPATH="\$PWD/lib:\$LIBPATH"
ZZ
}

zopen_get_version() {
  echo "${ARROW_VERSION}"
}
