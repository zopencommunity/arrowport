diff --git a/cpp/src/arrow/util/io_util.cc b/cpp/src/arrow/util/io_util.cc
index 03acd82..eebd284 100644
--- a/cpp/src/arrow/util/io_util.cc
+++ b/cpp/src/arrow/util/io_util.cc
@@ -2101,7 +2101,20 @@ Status SendSignalToThread(int signum, uint64_t thread_id) {
   return Status::NotImplemented("Cannot send signal to specific thread on Windows");
 #else
   // Have to use a C-style cast because pthread_t can be a pointer *or* integer type
+#  if defined(__MVS__)
+  // ...or, on z/OS, a struct:
+  //     typedef struct { unsigned long long __; } pthread_t;
+  // which no cast from uint64_t can produce. GetThreadId() above builds its
+  // value by memcpy-ing a std::thread::id -- which wraps pthread_t here -- into
+  // a uint64_t, so memcpy is the exact inverse of how the id was made.
+  pthread_t native_tid;
+  static_assert(sizeof(native_tid) <= sizeof(thread_id),
+                "pthread_t does not fit in the uint64_t thread id");
+  memcpy(&native_tid, &thread_id, sizeof(native_tid));
+  int r = pthread_kill(native_tid, signum);
+#  else
   int r = pthread_kill((pthread_t)thread_id, signum);  // NOLINT readability-casting
+#  endif
   if (r == 0) {
     return Status::OK();
   }
diff --git a/cpp/src/arrow/util/thread_pool.cc b/cpp/src/arrow/util/thread_pool.cc
index 4fbce97..d2c9d70 100644
--- a/cpp/src/arrow/util/thread_pool.cc
+++ b/cpp/src/arrow/util/thread_pool.cc
@@ -35,6 +35,13 @@
 
 #include "arrow/util/tracing_internal.h"
 
+#ifdef __MVS__
+// At file scope on purpose: zos-tls.h declares extern "C" entry points,
+// and including it inside namespace arrow::internal namespaces them, which
+// links as _ZN5arrow8internal21__tlsvaranchor_createEm UNRESOLVED.
+#include <zos-tls.h>
+#endif
+
 namespace arrow {
 namespace internal {
 
@@ -684,7 +691,18 @@ static void SetCurrentThreadPool(ThreadPool* pool) {
   }
 }
 #  else
+#    ifdef __MVS__
+// z/OS has no thread-local storage of any kind: thread_local, _Thread_local and
+// __thread are all rejected by the compiler, and no -mzos-target level changes
+// that. The __tlssim template from zoslib simulates it over a pthread key,
+// which preserves the semantics that matter here -- one ThreadPool pointer per
+// thread. Defining thread_local away instead would make every thread share one
+// pointer, and this variable is how a pool recognises its own worker threads.
+static __tlssim<ThreadPool*> current_thread_pool_tls_(nullptr);
+#      define current_thread_pool_ (*current_thread_pool_tls_.access())
+#    else
 thread_local ThreadPool* current_thread_pool_ = nullptr;
+#    endif
 
 static ThreadPool* GetCurrentThreadPool() { return current_thread_pool_; }
 static void SetCurrentThreadPool(ThreadPool* pool) { current_thread_pool_ = pool; }
